FROM eclipse-temurin:21-jre-alpine

# Install Python3, PyYAML, Git, Bash, and Curl
RUN apk add --no-cache python3 py3-yaml git bash curl

# Configure git default user identity from sync-manifest.yaml
ARG GIT_USER_NAME="Hybrid Syncer"
ARG GIT_USER_EMAIL="syncer@example.com"
RUN git config --global user.name "$GIT_USER_NAME" && \
    git config --global user.email "$GIT_USER_EMAIL"

WORKDIR /app

# Download pre-built Copybara JAR executable
# RUN curl -L -o /opt/copybara_deploy.jar https://github.com/google/copybara/releases/download/v20231109/copybara_deploy.jar || true
#
# Copy working JAR from host context
COPY copybara_deploy.jar /opt/copybara_deploy.jar

# Create copybara launcher script in PATH
RUN echo '#!/bin/bash' > /usr/local/bin/copybara && \
    echo 'java -jar /opt/copybara_deploy.jar "$@"' >> /usr/local/bin/copybara && \
    chmod +x /usr/local/bin/copybara

# Copy files into container image
COPY trigger-server.py /app/trigger-server.py

EXPOSE 8000

CMD ["python3", "/app/trigger-server.py"]
